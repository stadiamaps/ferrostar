{
  "name": "@stadiamaps/ferrostar-uniffi-react-native",
  "version": "0.57.0",
  "description": "Ferrostar React Native Binding",
  "source": "./src/index.tsx",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/uniffi/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/uniffi/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "scripts",
    "FerrostarRN.xcframework",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "ubrn:ios": "ubrn build ios     --config ubrn.config.yaml --and-generate",
    "ubrn:android": "ubrn build android --config ubrn.config.yaml --and-generate",
    "ubrn:checkout": "ubrn checkout      --config ubrn.config.yaml",
    "ubrn:clean": "del-cli \"cpp\" \"android/src/main/java\" \"android/src/main/jniLibs\" \"ios/\" \"FerrostarRN.xcframework\" \"src/Native*\" \"src/generated/\" \"src/index.ts*\"",
    "rust:clean": "cargo clean --manifest-path ../../common/ferrostar/Cargo.toml",
    "verify:native": "node scripts/verify-native-artifacts.mjs",
    "prepublish": "bun run ubrn:clean && bun run clean && bun run rust:clean && bun run ubrn:android --release && bun run ubrn:ios --release && bun run verify:native && bun run build && bun run codegen",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build lib",
    "build": "bob build",
    "codegen": "bob build --target codegen",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stadiamaps/ferrostar.git"
  },
  "author": {
    "name": "Benjamin Trounson"
  },
  "collaborators": [
    "Benjamin Trounson <btrounson@outlook.co.nz> (https://github.com/bjtrounson)",
    "Ian Wagner <ian@stadiamaps.com>",
    "Jacob Fielding <jacob@rallista.app>",
    "Luke Seelenbinder <luke@stadiamaps.com>"
  ],
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/stadiamaps/ferrostar/issues"
  },
  "homepage": "https://github.com/stadiamaps/ferrostar#readme",
  "dependencies": {
    "@ubjs/core": "0.31.0-5-contec.1",
    "uniffi-bindgen-react-native": "0.31.0-5"
  },
  "devDependencies": {
    "@react-native-community/cli": "20.2.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "del-cli": "^7.0.0",
    "jest": "^30.5.1",
    "react": "^19.2.0",
    "react-native": "^0.83.10",
    "react-native-builder-bob": "^0.43.1",
    "release-it": "^21.0.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "codegen",
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "FerrostarUniffiReactNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    },
    "android": {
      "javaPackageName": "com.stadiamaps.ferrostar"
    },
    "includesGeneratedCode": true
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "cpp",
    "version": "0.45.5"
  }
}
