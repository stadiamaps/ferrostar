  "collaborators": [
    "Benjamin Trounson <btrounson@outlook.co.nz> (https://github.com/bjtrounson)",
    "Ian Wagner <ian@stadiamaps.com>",
    "Jacob Fielding <jacob@rallista.app>",
    "Luke Seelenbinder <luke@stadiamaps.com>"
  ],
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/stadiamaps/ferrostar/issues"
  },
  "homepage": "https://github.com/stadiamaps/ferrostar#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@maplibre/maplibre-react-native": "11.3.10",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "del-cli": "^7.0.0",
    "react-native-svg": "^15.15.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-svg": "*"
  },
  "dependencies": {
    "@stadiamaps/ferrostar-core-react-native": "*",
    "@stadiamaps/ferrostar-uniffi-react-native": "*",
    "@turf/bbox": "^7.4.0"
